@startuml 01a_use_case_customer
!include _style.iuml
title Use Case Diagram (1/2) — Customer interaction
left to right direction

actor "Customer" as Customer
actor "Channel Provider\n(Telegram / WhatsApp /\nInstagram / Web Chat)" as Provider <<system>>

rectangle "Multi-Agent Platform" {
  usecase "Send message\nvia channel" as UC_Send
  usecase "Verify provider\nwebhook" as UC_Verify
  usecase "Ask about product\nand stock" as UC_Product
  usecase "Place order" as UC_Order
  usecase "Reserve inventory\nfor order" as UC_Reserve
  usecase "Check order /\ndelivery status" as UC_Status
  usecase "Answer clarification\nquestion" as UC_Clarify
  usecase "Escalate to\nhuman operator" as UC_Escalate
}

actor "LLM Provider\n(Gemini, dev)" as LLM <<system>>
actor "Human Operator" as Operator

Customer --> UC_Send
Customer --> UC_Product
Customer --> UC_Order
Customer --> UC_Status
Provider --> UC_Send
UC_Send ..> UC_Verify : <<include>>
UC_Order ..> UC_Reserve : <<include>>
UC_Clarify .up.> UC_Order : <<extend>>\n[missing data /\nwrite not confirmed]
UC_Escalate .up.> UC_Order : <<extend>>\n[low confidence / shortage /\noutcome unknown]
UC_Escalate .up.> UC_Status : <<extend>>
UC_Product --> LLM
UC_Order --> LLM
UC_Status --> LLM
UC_Escalate --> Operator

note "Sales / Support / Analytics agents are internal\ncomponents of the platform, not actors (D01)." as N1
@enduml
