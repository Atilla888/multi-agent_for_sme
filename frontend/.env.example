# Public browser-safe backend origin only. Never place credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only OIDC / BFF configuration. Never use NEXT_PUBLIC_ for secrets/tokens.
APP_ORIGIN=http://127.0.0.1:3000
API_SERVER_BASE_URL=http://127.0.0.1:8000
OIDC_ISSUER=http://127.0.0.1:8080/realms/REPLACE_WITH_APPROVED_REALM
OIDC_CLIENT_ID=REPLACE_WITH_APPROVED_CLIENT
# Optional for a confidential production client; set only in an ignored runtime env.
OIDC_CLIENT_SECRET=
APP_BUSINESS_ID=REPLACE_WITH_PROVISIONED_BUSINESS_UUID
# Explicit loopback development exception; use HTTPS and false in production.
OIDC_ALLOW_LOCAL_HTTP=true
# Optional deterministic review mode for integrated screens; still requires staff auth.
P5I_ENABLE_FIXTURE_REVIEW=false
