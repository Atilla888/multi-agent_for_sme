# P2 documentation-guided template. Do not run services with CHANGE_ME values.
# Copy to a local, git-ignored .env only in a later authorized setup step.

COMPOSE_PROJECT_NAME=sme_platform_dev
POSTGRES_DB=sme_platform_dev
POSTGRES_MIGRATOR_USER=platform_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
POSTGRES_RUNTIME_USER=platform_runtime
POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=local_minio_root
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_APP_USER=local_minio_app
MINIO_APP_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD
MINIO_APP_BUCKET=sme-private-objects
KEYCLOAK_ADMIN=local_keycloak_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD

# Optional local port overrides. Compose already has defaults.
# BACKEND_PORT=8000
# KEYCLOAK_PORT=8081

# M08 provider work is deferred; do not add API credentials here.
# P5I optional HTTP transport configuration (no secrets).
OIDC_ISSUER=http://127.0.0.1:8080/realms/REPLACE_WITH_APPROVED_REALM
OIDC_AUDIENCE=business-api
OIDC_JWKS_TRANSPORT_URL=http://keycloak:8080/realms/REPLACE_WITH_APPROVED_REALM/protocol/openid-connect/certs
KEYCLOAK_PUBLIC_ORIGIN=http://127.0.0.1:8080
OIDC_ALLOW_LOCAL_HTTP=true
HTTP_CORS_ORIGINS=http://127.0.0.1:3000
